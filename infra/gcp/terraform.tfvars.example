# Environment-specific non-secret Terraform inputs.
# Database and application secrets belong in the ignored .env.secrets file.

project_id       = "your-gcp-project-id"
environment      = "dev"
domain_name      = "dev.example.com"
google_client_id = "replace-with-google-oauth-client-id"

# Optional overrides (defaults derive from domain_name in env tfvars):
# platform_api_url = "https://api.your-domain.example"
# public_api_url   = "https://api.your-domain.example"
# cors_origins     = "https://www.your-domain.example,https://your-domain.example"
