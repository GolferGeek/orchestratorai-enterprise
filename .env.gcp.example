# OrchestratorAI Enterprise — Google Cloud provider profile
# Copy to .env.gcp and supply secrets through Secret Manager or .env.secrets.gcp.

# Unified runtime
NODE_ENV=production
PLATFORM_API_PORT=6700
# Required at API startup: AuthClient uses this for authorization callbacks.
# Set to the public HTTPS API origin (same value as PUBLIC_API_URL in most GCP deploys).
PLATFORM_API_URL=https://api.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

# Provider selectors
DB_PROVIDER=postgresql
RAG_PROVIDER=postgresql
STORAGE_PROVIDER=gcs
LLM_PROVIDER=openrouter
CONFIG_PROVIDER=gcp_secret_manager
AUTH_PROVIDER=google_oidc
OBSERVABILITY_PROVIDER=database_events
WORK_PROVIDER=slack

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_SITE_URL=https://app.example.com
OPENROUTER_SITE_NAME=OrchestratorAI
OPENROUTER_AUTO_ALLOWED_MODELS=["anthropic/*","openai/*","google/*","deepseek/*"]
OPENROUTER_AUTO_COST_QUALITY_TRADEOFF=3
OPENROUTER_VIDEO_ENABLED=false
OPENROUTER_VIDEO_RETENTION_ACKNOWLEDGED=false

# Google Cloud
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=us-central1
GCS_PROJECT_ID=replace-with-gcp-project-id
GCS_BUCKET_MEDIA=replace-with-media-bucket
GCS_BUCKET_LEGAL=replace-with-legal-bucket
GCS_SIGNED_URL_TTL_SECONDS=900

# Cloud SQL for PostgreSQL
# For Cloud Run with the Cloud SQL connector, use the connector-supported socket URL.
POSTGRESQL_URL=postgresql://app-user:replace-me@cloud-sql-host:5432/orchestratorai
DATABASE_URL=postgresql://app-user:replace-me@cloud-sql-host:5432/orchestratorai
RAG_POSTGRESQL_URL=postgresql://app-user:replace-me@cloud-sql-host:5432/orchestratorai

# Google OIDC
GOOGLE_ISSUER_URL=https://accounts.google.com
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Required application configuration
JWT_SECRET=replace-with-strong-random-secret
ASSET_FETCH_EXTERNAL=false
ASSET_FETCH_MAX_BYTES=26214400
ASSET_EXTERNAL_STRATEGY=redirect
MEDIA_STORAGE_BUCKET=replace-with-media-bucket

# Web build-time configuration
VITE_API_BASE_URL=/api
VITE_MONOLITH_MODE=true
VITE_AUTH_PROVIDER=google_oidc
VITE_CONFIG_PROVIDER=gcp_secret_manager
VITE_DB_PROVIDER=postgresql
VITE_STORAGE_PROVIDER=gcs
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
VITE_GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback
VITE_ENFORCE_HTTPS=true
VITE_REQUIRE_SECURE_CONTEXT=true
