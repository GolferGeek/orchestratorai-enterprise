# =============================================================================
# OrchestratorAI Enterprise — Unified Platform Environment Template
# =============================================================================
# Copy this file to .env and put secrets in .env.secrets.
#
# Local Node dev uses 127.0.0.1 for Supabase/Postgres.
# Docker Compose API containers should use host.docker.internal so they can
# reach Supabase running on the host.
# =============================================================================

# --- Unified platform runtime ---
PLATFORM_API_PORT=6700
# Required: AuthClient refuses to start without it (auth authorization callbacks).
# Local Node: http://127.0.0.1:6700
# Spark / docker compose gateway: overridden to http://platform-api:6700 by
# docker-compose.cloudflare.yml and scripts/deploy-platform.sh (npm run deploy:spark).
PLATFORM_API_URL=http://127.0.0.1:6700
VITE_PLATFORM_WEB_PORT=6701
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:6700
VITE_MONOLITH_MODE=true

# --- Database (local Supabase; see supabase/config.toml) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321

# Docker Compose alternative for API containers:
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_URL=http://host.docker.internal:54321

# --- Auth/session ---
JWT_EXPIRATION=3600

# --- Secure Conversations boundary ---
SECURITY_MODE=strict
ORIGIN_VALIDATION=strict
TRUSTED_ORIGINS=https://external-agent.example
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Keep false outside isolated local development. When true, external-agent
# discovery and outbound calls may reach loopback/private network addresses.
SECURE_CONVERSATIONS_ALLOW_PRIVATE_NETWORKS=false
# Canonical public callback URL used for Twilio signature verification.
TWILIO_WEBHOOK_URL=https://api.example.com/secure-conversations/webhooks/whatsapp

# --- Provider selectors ---
AUTH_PROVIDER=supabase
CONFIG_PROVIDER=local
DB_PROVIDER=supabase_pg
RAG_PROVIDER=supabase_pg
EMBEDDING_MODEL=nomic-embed-text
STORAGE_PROVIDER=supabase_storage
LLM_PROVIDER=openrouter
OBSERVABILITY_PROVIDER=database_events
WORK_PROVIDER=slack

# --- OpenRouter (API key belongs in .env.secrets) ---
OPENROUTER_SITE_URL=https://orchestratorai.io
OPENROUTER_SITE_NAME=OrchestratorAI
OPENROUTER_AUTO_ALLOWED_MODELS=["anthropic/*","openai/*","google/*","deepseek/*"]
OPENROUTER_AUTO_COST_QUALITY_TRADEOFF=3
OPENROUTER_VIDEO_ENABLED=false
# Video is not eligible for OpenRouter zero-data-retention. Set both values to
# true only after accepting that retention boundary.
OPENROUTER_VIDEO_RETENTION_ACKNOWLEDGED=false

VITE_AUTH_PROVIDER=supabase
VITE_CONFIG_PROVIDER=local
VITE_DB_PROVIDER=supabase_pg
VITE_STORAGE_PROVIDER=supabase_storage
VITE_WORK_PROVIDER=slack
VITE_KNOWLEDGE_PROVIDER=none
VITE_ENFORCE_HTTPS=false
VITE_REQUIRE_SECURE_CONTEXT=false

# --- Cloudflare Tunnel overlay ---
CF_PUBLIC_URL=https://orchestratorai.io
CF_LOCAL_PORT=7777
CORS_ORIGINS=https://orchestratorai.io,https://www.orchestratorai.io,https://app.orchestratorai.io,http://localhost:7777,http://localhost:6701

# Spark/enterprise Docker deployment uses docker-compose.cloudflare.yml to set:
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:6011/postgres
# SUPABASE_URL=http://host.docker.internal:6010

# --- Secrets (put these in .env.secrets, NOT here) ---
# SUPABASE_ANON_KEY=<key>
# SUPABASE_SERVICE_ROLE_KEY=<key>
# SUPABASE_TEST_USER=<integration-test-email>
# SUPABASE_TEST_PASSWORD=<integration-test-password>
# ANTHROPIC_API_KEY=<key>
# OPENAI_API_KEY=<key>
# OPENROUTER_API_KEY=<key>
# GOOGLE_API_KEY=<key>
# GEMINI_API_KEY=<key>
# JWT_SECRET=<secret>
# GUEST_SESSION_SECRET=<secret>
# STREAM_TOKEN_SECRET=<strong-random-secret>
# SECURE_CONVERSATIONS_SIGNING_KEY=<strong-random-secret>
# TELEGRAM_WEBHOOK_SECRET=<A-Z-a-z-0-9-underscore-or-hyphen>
# TWILIO_AUTH_TOKEN=<secret>
# STRIPE_SECRET_KEY=<key>
# STRIPE_WEBHOOK_SECRET=<key>
