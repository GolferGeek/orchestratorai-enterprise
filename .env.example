# =============================================================================
# OrchestratorAI Enterprise — Unified Platform Environment Template
# =============================================================================
# Copy this file to .env and put secrets in .env.secrets.
#
# Local Node dev uses 127.0.0.1 for Supabase/Postgres.
# Docker Compose API containers should use host.docker.internal so they can
# reach Supabase running on the host.
# =============================================================================

# --- Unified platform runtime ---
PLATFORM_API_PORT=6700
VITE_PLATFORM_WEB_PORT=6701
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:6700
VITE_MONOLITH_MODE=true
VITE_DEMO_USER_EMAIL=demo-user@orchestratorai.io
VITE_DEMO_USER_PASSWORD=DemoUser123!

# --- Database (local Supabase; see supabase/config.toml) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321

# Docker Compose alternative for API containers:
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_URL=http://host.docker.internal:54321

# --- Auth/session ---
JWT_EXPIRATION=3600

# --- Provider selectors ---
VITE_AUTH_PROVIDER=supabase
VITE_CONFIG_PROVIDER=local
VITE_DB_PROVIDER=supabase_pg
VITE_STORAGE_PROVIDER=supabase_storage
VITE_WORK_PROVIDER=slack
VITE_KNOWLEDGE_PROVIDER=none
VITE_ENFORCE_HTTPS=false
VITE_REQUIRE_SECURE_CONTEXT=false

# --- Cloudflare Tunnel overlay ---
CF_PUBLIC_URL=https://orchestratorai.io
CF_LOCAL_PORT=7777
CORS_ORIGINS=https://orchestratorai.io,https://www.orchestratorai.io,https://app.orchestratorai.io,http://localhost:7777,http://localhost:6701

# Spark/enterprise Docker deployment uses docker-compose.cloudflare.yml to set:
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:6011/postgres
# SUPABASE_URL=http://host.docker.internal:6010

# --- Secrets (put these in .env.secrets, NOT here) ---
# SUPABASE_ANON_KEY=<key>
# SUPABASE_SERVICE_ROLE_KEY=<key>
# ANTHROPIC_API_KEY=<key>
# OPENAI_API_KEY=<key>
# OPENROUTER_API_KEY=<key>
# GOOGLE_API_KEY=<key>
# GEMINI_API_KEY=<key>
# JWT_SECRET=<secret>
# GUEST_SESSION_SECRET=<secret>
# STRIPE_SECRET_KEY=<key>
# STRIPE_WEBHOOK_SECRET=<key>
