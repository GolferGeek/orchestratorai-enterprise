{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["src/*"],
      "@/database": ["../../packages/planes/database"],
      "@/database/*": ["../../packages/planes/database/*"],
      "@orchestratorai/auth-client": ["../../packages/auth-client/src"],
      "@orchestratorai/auth-client/*": ["../../packages/auth-client/src/*"],
      "@orchestratorai/planes": ["../../packages/planes"],
      "@orchestratorai/planes/*": ["../../packages/planes/*"],
      "@orchestrator-ai/transport-types": ["../../packages/transport-types/src"],
      "@orchestrator-ai/transport-types/*": ["../../packages/transport-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
