{
  "name": "orchestratorai-enterprise",
  "private": true,
  "license": "PROPRIETARY",
  "packageManager": "npm@10.2.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "build:transport-types": "cd packages/transport-types && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && VITE_PLATFORM_WEB_PORT=6701 VITE_API_BASE_URL=/api VITE_MONOLITH_MODE=true npm run build",
    "audit:accepted": "node scripts/audit-with-accepted-risks.mjs",

    "dev:all": "./scripts/dev-servers.sh start",
    "dev:stop": "./scripts/dev-servers.sh stop",
    "dev:api": "cd apps/api && PLATFORM_API_PORT=6700 npm run start:dev",
    "dev:web": "cd apps/web && VITE_PLATFORM_WEB_PORT=6701 VITE_API_BASE_URL=/api VITE_API_PROXY_TARGET=http://127.0.0.1:6700 VITE_MONOLITH_MODE=true npm run dev",

    "test:integration": "jest --config tests/integration/jest.config.ts --runInBand",
    "test:integration:auth": "jest --config tests/integration/jest.config.ts --testPathPattern 01-auth",
    "test:integration:health": "jest --config tests/integration/jest.config.ts --testPathPattern 02-health",
    "test:integration:admin": "jest --config tests/integration/jest.config.ts --testPathPattern 06-admin",

    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:local": "./scripts/deploy-platform.sh local",
    "deploy:spark": "./scripts/deploy-platform.sh spark"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.3.3"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/transport-types",
    "packages/planes",
    "packages/ui"
  ]
}
